# GitHub repository slug (e.g. yourusername/finansc)
# Used by docker-compose.yml to reference the correct GHCR image
GITHUB_REPOSITORY=yourusername/finansc

# Database
DB_HOST=
DB_PORT=5432
DB_USERNAME=finanscozum
DB_PASSWORD=your_db_password
DB_DATABASE=finanscozum
DB_SSL=false

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
