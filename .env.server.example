# GitHub repository slug (e.g. yourusername/finansc)
# Used by docker-compose.yml to reference the correct GHCR image
GITHUB_REPOSITORY=yourusername/finansc

# ── Runtime ────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database ──────────────────────────────────────
DB_HOST=72.62.93.150
DB_PORT=5432
DB_NAME=finanscozum
DB_USERNAME=finanscozum
DB_PASSWORD=your_db_password
DB_SSL=false

# ── JWT ───────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_min32
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_min32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── External API (market data) ────────────────────
EXTERNAL_API_BASE_URL=https://your-market-api.example.com
EXTERNAL_API_KEY=

# ── CORS ──────────────────────────────────────────
CORS_ORIGIN=https://finanscozum.net,https://www.finanscozum.net

# ── Rate limiting ─────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── SMTP (optional) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@finanscozum.net
