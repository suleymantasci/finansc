# ── Runtime ────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_SSL=false

# ── JWT ───────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── External API ──────────────────────────────────
# TÜFE/ÜFE endeks kaynağı (TÜİK TCMB verisi, upstream market API)
# Prod: https://api.finanscozum.net üzerinden proxy
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=

# ── CORS ──────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Throttle ──────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── SMTP (optional) ──────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
